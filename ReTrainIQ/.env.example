# Optional. Without these the system uses its fallbacks (manual profile, default metric plan, template summary).
# LLM_PROVIDER: openrouter | anthropic | openai | gemini | groq | ollama
# (or any name plus LLM_BASE_URL for a custom OpenAI-compatible API)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# LLM_BASE_URL=
# OpenRouter example:
# LLM_PROVIDER=openrouter
# LLM_API_KEY=your_key
# LLM_MODEL=openrouter/free
# LLM_BASE_URL=https://openrouter.ai/api/v1
